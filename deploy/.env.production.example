# ── Production environment template (single-server Docker deploy) ────────────
# Copy to deploy/.env.production (gitignored) and fill with REAL values.
# Never commit this file. Every value below is a placeholder.
#
# Deployment: see deploy/README.md.

# ══ Strong production credentials ═══════════════════════════════════════
# Generate with: openssl rand -base64 32   (or a strong random source)
POSTGRES_USER=replace_with_prod_user
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=insightforge

# JWT signing secret — strong random, >= 32 bytes.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace_with_strong_random_secret

# ══ Server-only API keys (real values) ══════════════════════════════════
GROQ_API_KEY=replace_with_real_groq_key
TAVILY_API_KEY=replace_with_real_tavily_key
# TAVILY_KEY_KEY=replace_with_real_tavily_key
GOOGLE_API_KEY=replace_with_real_google_key

# ══ Frontend / URLs (Phase 2F Step 15 — HTTPS) ═══════════════════════════
# Public domain served by Caddy. Point a DNS A record at this server's
# public IP; Caddy then provisions a trusted Let's Encrypt certificate.
# With DOMAIN=localhost, Caddy uses its internal CA (local testing only).
DOMAIN=your-domain.example.com

# Public origin the browser uses to reach the app — SAME origin as the
# frontend (Caddy routes /auth/* and /research/* to the backend), so the
# API and cookies are same-origin over HTTPS.
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com
# Comma-separated allowed origins for the frontend (explicit origins only).
# Same-origin calls don't trigger CORS; this must match the production origin.
CORS_ORIGINS=https://your-domain.example.com

# HttpOnly cookie over HTTPS: Secure flag MUST be true in production.
AUTH_COOKIE_SECURE=true

# ══ Compose wiring (internal to this stack; normally no change needed) ═══
# Points the backend service's env_file at THIS production file.
BACKEND_ENV_FILE=deploy/.env.production
