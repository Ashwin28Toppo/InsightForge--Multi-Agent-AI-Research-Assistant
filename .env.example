# ── InsightForge environment example ────────────────────────────────────────
# Copy this file to .env and fill in your own values. Never commit real keys.

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.0
# LLM_RATE_LIMIT_RETRIES=5
# RESEARCH_LOOP_MAX_ROUNDS=0   # 0 = single pass (no loop); 2 = original looped behavior

# ── Token budget (free tier: 6000 TPM) ───────────────────────────────────────
# LLM_MAX_TOKENS=1536          # cap output per LLM generation
# EVIDENCE_MAX_CHARS=300       # cap per web-evidence item (same text shared per source)
# SEARCH_SNIPPET_MAX_CHARS=150 # per Tavily result snippet
# RUN_CRITIC=false             # critic re-reads the whole report; enable on a higher tier

# ── API / CORS ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the future Next.js frontend.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JOB_TTL_SECONDS=3600        # how long completed/failed jobs stay queryable

# ── Database (Phase 2F Step 2 — optional until persistence lands) ────────────
# Async PostgreSQL URL for the ORM/session layer and Alembic migrations.
# Leave unset and the application keeps running fully in-memory.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insightforge

# ── Web research (Tavily) ───────────────────────────────────────────────────
# TAVILY_API_KEY is the canonical name. The project historically also accepted
# TAVILY_KEY_KEY; both are supported by the config loader.
TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_KEY_KEY=your_tavily_api_key_here

# ── Embeddings (Gemini) ─────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=768

# ── Qdrant vector store ─────────────────────────────────────────────────────
# Phase 2 uses Qdrant local embedded mode via QDRANT_PATH (no server needed).
# QDRANT_URL is optional — set it later to switch to a remote Qdrant server
# (e.g. http://localhost:6333).
# QDRANT_PATH=./qdrant_storage
# QDRANT_URL=
# QDRANT_COLLECTION=insightforge_documents

# ── Document chunking / retrieval ───────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.5

# ── Storage ─────────────────────────────────────────────────────────────────
# DOCUMENT_STORAGE_DIR=./data/documents
