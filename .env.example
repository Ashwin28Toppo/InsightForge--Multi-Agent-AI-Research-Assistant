# ── InsightForge environment example ────────────────────────────────────────
# Copy this file to .env and fill in your own values. NEVER commit real keys.
#
# Categories (all server-only unless marked "FRONTEND"):
#   · Server-only secrets/API keys   — backend containers only
#   · Database credentials           — backend + postgres services
#   · Qdrant configuration           — backend service
#   · Frontend NEXT_PUBLIC_*         — baked into the public client bundle
#   · Production application config  — optional; defaults exist in code
#
# The Docker Compose stack injects server secrets ONLY into the backend
# (via `env_file: .env`); the frontend service receives nothing but
# NEXT_PUBLIC_API_BASE_URL and never sees these values.

# ══ Server-only secrets / API keys ═══════════════════════════════════════
# LLM provider (Groq). Required for real research jobs.
GROQ_API_KEY=your_groq_api_key_here

# Web search (Tavily). TAVILY_API_KEY is canonical; TAVILY_KEY_KEY is also
# accepted for backwards compatibility. Required for real research jobs.
TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_KEY_KEY=your_tavily_api_key_here

# Embeddings (Google Gemini). Required for RAG retrieval.
GOOGLE_API_KEY=your_google_api_key_here

# JWT signing secret — REQUIRED in production. Must be a strong random value
# (>= 32 bytes so PyJWT's HS256 key-length check stays quiet). The value below
# is a development placeholder only; never use it outside local dev.
AUTH_JWT_SECRET=change-me-in-development-0123456789abcdef0123456789abcdef

# ══ Database credentials ═════════════════════════════════════════════════
# The Docker Compose `postgres` service builds DATABASE_URL from these.
# POSTGRES_USER=insightforge
# POSTGRES_PASSWORD=insightforge
# POSTGRES_DB=insightforge

# Full async PostgreSQL URL (used when running outside Compose, and the
# source of truth for Alembic migrations). Leave unset to run in-memory.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/insightforge

# ══ Qdrant configuration ═════════════════════════════════════════════════
# Docker Compose sets QDRANT_URL to the internal `qdrant` service; override
# only if you run a remote Qdrant server.
# QDRANT_URL=http://localhost:6333
# Local embedded mode (used when QDRANT_URL is unset).
# QDRANT_PATH=./qdrant_storage
# QDRANT_COLLECTION=insightforge_documents

# ══ Frontend (NEXT_PUBLIC_* — public, baked into the client bundle) ══════
# Base URL the browser uses to reach the backend. Must be a public origin,
# never a secret. In Docker the backend is published on the host at :8000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ══ Production application configuration (optional; defaults in code) ════
# CORS: comma-separated allowed origins for the frontend. Explicit origins
# only — never "*".
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Auth cookie/JWT tuning.
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_EXPIRE_MINUTES=60
# AUTH_COOKIE_NAME=insightforge_access
# AUTH_COOKIE_SECURE=false   # MUST be true behind HTTPS in production
# AUTH_COOKIE_SAMESITE=lax

# How long terminal (completed/failed) jobs stay queryable (seconds).
# JOB_TTL_SECONDS=3600

# LLM + research pipeline tuning (free-tier-friendly defaults).
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.0
# LLM_RATE_LIMIT_RETRIES=5
# RESEARCH_LOOP_MAX_ROUNDS=0   # 0 = single pass (no loop)
# LLM_MAX_TOKENS=1536          # cap output per LLM generation
# EVIDENCE_MAX_CHARS=300
# SEARCH_SNIPPET_MAX_CHARS=150
# RUN_CRITIC=false             # critic re-reads the whole report; enable on a higher tier

# Embeddings / retrieval.
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=768
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.5

# Web research.
# TAVILY_MAX_RESULTS=5
# SCRAPE_MAX_CHARS=3000
# SCRAPE_TIMEOUT=8

# Document chunking / storage.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# DOCUMENT_STORAGE_DIR=./data/documents
